# Copy this file to .env.local and fill in the values from your Supabase project
# (Dashboard -> Project Settings -> API Keys). Restart `npm run dev` afterwards.

# Safe to expose to the browser. Newer projects may call this the "publishable"
# key (sb_publishable_...) instead of "anon" - either works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security, so it must never be given a
# NEXT_PUBLIC_ prefix - that would ship an admin database key to every visitor.
# Newer projects may call this the "secret" key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults to OpenStreetMap's own tile server (no key needed, but
# not meant for heavy/commercial traffic - see their usage policy). This app
# actually runs on MapTiler's free tier (free.maptiler.com - no credit card
# needed, 100k map loads/month): sign up, create a key under Account -> Keys,
# and optionally restrict it to your dev/prod origins (bare hostnames, no
# scheme - e.g. "localhost:3000", not "http://localhost:3000"). Verified URL
# format as of writing - MapTiler's raster tile docs (docs.maptiler.com/cloud/api/maps)
# call this "Raster XYZ tiles", explicitly Leaflet-compatible:
# NEXT_PUBLIC_TILE_URL=https://api.maptiler.com/maps/streets-v4/256/{z}/{x}/{y}{r}.png?key=YOUR_KEY
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
